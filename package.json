{
  "name": "@cinatra-ai/apify-connector",
  "version": "0.1.4",
  "files": [
    "src",
    "!src/__tests__"
  ,
    "cinatra"],
  "license": "Apache-2.0",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./register": "./src/register.ts",
    "./mcp-toolbox": "./src/mcp/toolbox.ts"
  },
  "types": "src/index.ts",
  "scripts": {
    "test": "vitest",
    "lint": "eslint . --no-inline-config"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "radix-ui": "^1.4.3",
    "tailwind-merge": "^3.5.0"
  },
  "peerDependencies": {
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "@cinatra-ai/sdk-extensions": "*",
    "@cinatra-ai/sdk-ui": "*"
  },
  "peerDependenciesMeta": {
    "@cinatra-ai/sdk-extensions": {
      "optional": true
    },
    "@cinatra-ai/sdk-ui": {
      "optional": true
    }
  },
  "devDependencies": {
    "@typescript-eslint/parser": "8.64.0",
    "eslint": "10.7.0",
    "typescript": "7.0.2"
  },
  "cinatra": {
    "apiVersion": "cinatra.ai/v1",
    "kind": "connector",
    "consumes": [],
    "vendor": {
      "key": "cinatra-ai",
      "name": "Cinatra"
    },
    "displayName": "Apify",
    "providesExternalMcpToolbox": true,
    "dependencies": [],
    "serverEntry": "./register",
    "requestedHostPorts": [
      "nango",
      "capabilities",
      "ui"
    ],
    "sdkAbiRange": "^2",
    "providerConfigKey": "cinatra-apify",
    "uiSurface": "schema-config",
    "configSchema": {
      "title": "Apify",
      "description": "Connect an Apify API token so Apify actor tools are available in every LLM call. The token is validated against Apify and stored securely via the connection service.",
      "fields": [
        {
          "kind": "banner",
          "label": "Result",
          "variants": [
            { "name": "saved", "tone": "success", "message": "Apify connection saved." },
            { "name": "cleared", "tone": "warning", "message": "Apify connection cleared." },
            { "name": "error", "tone": "destructive", "message": "Something went wrong." }
          ]
        },
        {
          "kind": "status-probe",
          "label": "Connection",
          "actionId": "connectionStatus",
          "description": "Check whether the Apify token is configured and the MCP server is active."
        },
        {
          "kind": "secret",
          "key": "apiKey",
          "label": "Apify API token",
          "description": "Create a token at console.apify.com. Write-only — the stored value is never shown again."
        },
        {
          "kind": "named-action",
          "label": "Save connection",
          "actionId": "saveConnection"
        },
        {
          "kind": "named-action",
          "label": "Clear connection",
          "actionId": "clearConnection",
          "confirm": "Clear the stored Apify connection?"
        }
      ],
      "tabs": [
        {
          "id": "help",
          "label": "Help",
          "fields": [
            {
              "kind": "advisory",
              "label": "Apify setup",
              "tone": "info",
              "probeActionId": "connectionServiceReady",
              "whenReady": "API tokens are stored securely via the connection service. Use the Setup tab to update or clear your Apify API token.",
              "whenNotReady": "Configure the connection service first so Apify requests can authenticate. Once it is ready, create a token at console.apify.com and paste it into the Setup tab's API token field, then click Save connection — the token is validated against Apify before it is stored and is never shown again.",
              "description": "Read-only setup guidance — nothing on this tab is saved."
            }
          ]
        }
      ]
    }
  }
}
